# 复制为 Git 忽略的 runtime.env，并为所有空值填入互不相同的真实配置。
AI_GDM_IMAGE=ai-gdm/server:local
AI_GDM_BIND_ADDRESS=0.0.0.0
AI_GDM_HTTP_PORT=8080

POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=

APP_ENV=production
APP_LOG_LEVEL=info
APP_SHUTDOWN_TIMEOUT=30s
APP_ADMIN_TOKEN=
APP_RATE_LIMIT_PER_MINUTE=120
APP_RATE_LIMIT_BURST=30

REFRESH_ENABLED=true
REFRESH_INTERVAL=30m
REFRESH_TIMEOUT=10m

OPEN_METEO_POINTS=104.066500,30.572300;102.712300,25.040600
OPEN_METEO_PAST_HOURS=72
OPEN_METEO_FORECAST_HOURS=24
OPEN_METEO_FALLBACK_MAX_AGE=6h

LHASA_STALE_AFTER=12h

AMAP_ENABLED=false
AMAP_API_KEY=

BOCHA_ENABLED=false
BOCHA_API_KEY=

LLM_ENABLED=false
LLM_PROVIDER_NAME="Jojocode OpenAI 兼容服务"
LLM_BASE_URL=https://jojocode.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-5.6-terra
LLM_MAX_COMPLETION_TOKENS=1200
LLM_OUTPUT_ATTEMPTS=2
